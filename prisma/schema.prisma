generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStage {
  DISCOVERED
  OUTREACH_SENT
  RECRUITER_ENGAGED
  RTR_SIGNED
  SUBMITTED_TO_CLIENT
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  HIRED
  NO_RESPONSE
  REJECTED
  ROLE_CLOSED
  WITHDRAWN
  DUPLICATE
}

enum ActivityType {
  JOB_CREATED
  JOB_UPDATED
  JD_RECEIVED
  OUTREACH_SENT
  RECRUITER_REPLY
  CALL
  RTR_RECEIVED
  RTR_SIGNED
  CLIENT_SUBMISSION
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  STAGE_CHANGED
  NOTE
  CORRECTION
  RESUME_SELECTED
  OUTREACH_DRAFT_GENERATED
  OUTREACH_DRAFT_EDITED
  OUTREACH_DRAFT_APPROVED
  OUTLOOK_DRAFT_CREATED
}

enum EmploymentType {
  UNKNOWN
  CONTRACT
  W2
  C2C
  CONTRACT_1099
  FULL_TIME
}

enum WorkArrangement {
  UNKNOWN
  REMOTE
  HYBRID
  ONSITE
}

enum JobSourceType {
  LINKEDIN_POST
  LINKEDIN_DM
  DIRECT_EMAIL
  FORWARDED_JD
  PLAIN_TEXT
}

enum IntakeStatus {
  PENDING
  CONFIRMED
}

enum OutreachMode {
  FIRST_OUTREACH
  THREAD_FOLLOW_UP
  DIRECT_EMAIL_REPLY
  FORWARDED_JD_OUTREACH
}

enum OutreachDraftStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
}

enum OutlookDraftState {
  NOT_CREATED
  CREATING
  CREATED
  FAILED
  NEEDS_REVIEW
  SENT
}

/// What the autopilot does with an Outlook draft it built. SHADOW only records when it would have
/// sent; SCHEDULED waits out the delay; SENDING is claimed and never retried, so no mail goes twice.
enum AutoSendState {
  SHADOW
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum FollowUpStatus {
  PENDING
  FAILED
  CONFIRMED
  DISMISSED
}

enum TaskStatus {
  RUNNING
  DONE
  FAILED
}

enum TaskKind {
  INTAKE_PIPELINE
  OUTREACH_REGENERATE
  OUTREACH_VALIDATE
  OUTLOOK_DRAFT
  OUTLOOK_SENT_CHECK
  FOLLOW_UP_SCAN
  FOLLOW_UP_RETRY
  AUTO_SEND
}

enum FollowUpEvent {
  RECRUITER_REPLY
  RTR_RECEIVED
  CLIENT_SUBMISSION
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFER
  REJECTION
  ROLE_CLOSED
  NO_ACTION
}

/// The role families the user maintains. Codes are the values stored on jobs and resumes, so a
/// rename cascades and a family still in use cannot be deleted -- both enforced by the database.
model RoleFamily {
  code          String        @id
  label         String
  /// One line telling the analyzer how to tell this family from the others.
  description   String
  active        Boolean       @default(true)
  sortOrder     Int           @default(0) @map("sort_order")
  opportunities Opportunity[]
  resumes       Resume[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("role_families")
}

model Opportunity {
  id               String            @id @default(cuid())
  title            String
  client           String?
  location         String?
  roleFamily       String?           @map("role_family")
  roleFamilyOption RoleFamily?       @relation(fields: [roleFamily], references: [code], onDelete: Restrict, onUpdate: Cascade)
  employmentType   EmploymentType    @default(UNKNOWN) @map("employment_type")
  workArrangement  WorkArrangement   @default(UNKNOWN) @map("work_arrangement")
  rawJd            String?           @map("raw_jd")
  jobCase          Json?             @map("job_case")
  jdFingerprint    String?           @map("jd_fingerprint")
  /// Share of the JD's skills the approved context covers, 0..1; null when the JD listed none.
  matchScore       Float?            @map("match_score")
  matchReport      Json?             @map("match_report")
  recruiterId      String?           @map("recruiter_id")
  vendorId         String?           @map("vendor_id")
  selectedResumeId String?           @map("selected_resume_id")
  recruiter        Recruiter?        @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  selectedResume   Resume?           @relation(fields: [selectedResumeId], references: [id], onDelete: SetNull)
  applicationTrack ApplicationTrack?
  intake           JobIntake?
  activities       Activity[]
  outreachDraft    OutreachDraft?
  followUpSuggestions FollowUpSuggestion[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([recruiterId])
  @@index([vendorId])
  @@index([selectedResumeId])
  @@index([roleFamily])
  @@index([jdFingerprint])
  @@map("opportunities")
}

model JobIntake {
  id                 String        @id @default(cuid())
  sourceType         JobSourceType @map("source_type")
  rawText            String        @map("raw_text")
  originalSender     String?       @map("original_sender")
  receivedAt         DateTime      @map("received_at")
  attachmentMetadata Json?         @map("attachment_metadata")
  analysis           Json?
  preview            Json?
  fingerprint        String
  sourceMessageId    String?       @unique @map("source_message_id")
  status             IntakeStatus  @default(PENDING)
  opportunityId      String?       @unique @map("opportunity_id")
  opportunity        Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  confirmedAt        DateTime?     @map("confirmed_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([fingerprint])
  @@map("job_intakes")
}

/** What the inbox scan decided about a message, so a dry run is reviewable and no mail is judged twice. */
model IntakeScanDecision {
  id               String   @id @default(cuid())
  outlookMessageId String   @unique @map("outlook_message_id")
  fromAddress      String   @map("from_address")
  subject          String
  receivedAt       DateTime @map("received_at")
  imported         Boolean  @default(false)
  confidence       Float
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("intake_scan_decisions")
}

model ApplicationTrack {
  id             String           @id @default(cuid())
  opportunityId  String           @unique @map("opportunity_id")
  currentStage   ApplicationStage @default(DISCOVERED) @map("current_stage")
  waitingOn      String?          @map("waiting_on")
  nextAction     String?          @map("next_action")
  nextFollowUpAt DateTime?        @map("next_follow_up_at")
  attentionClearedAt DateTime?    @map("attention_cleared_at")
  opportunity    Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([currentStage])
  @@index([nextFollowUpAt])
  @@map("application_tracks")
}

model Activity {
  id            String       @id @default(cuid())
  opportunityId String       @map("opportunity_id")
  type          ActivityType
  description   String
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([opportunityId, occurredAt])
  @@map("activities")
}

model Recruiter {
  id            String        @id @default(cuid())
  name          String
  email         String?
  phone         String?
  linkedinUrl   String?       @map("linkedin_url")
  notes         String?
  vendorId      String?       @map("vendor_id")
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([name])
  @@index([vendorId])
  @@map("recruiters")
}

model Vendor {
  id            String        @id @default(cuid())
  name          String        @unique
  recruiters    Recruiter[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("vendors")
}

model Resume {
  id         String     @id @default(cuid())
  name       String
  roleFamily String     @map("role_family")
  roleFamilyOption RoleFamily @relation(fields: [roleFamily], references: [code], onDelete: Restrict, onUpdate: Cascade)
  filePath   String     @map("file_path")
  version    String
  active     Boolean    @default(true)
  opportunities Opportunity[]
  outreachDrafts OutreachDraft[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@unique([name, version])
  @@map("resumes")
}

model OutreachDraft {
  id                 String              @id @default(cuid())
  opportunityId      String              @unique @map("opportunity_id")
  mode               OutreachMode
  toAddress           String              @map("to_address")
  ccAddress           String?             @map("cc_address")
  subject             String
  body                String
  attachmentResumeId String              @map("attachment_resume_id")
  contextFingerprint String              @map("context_fingerprint")
  validation         Json
  status             OutreachDraftStatus @default(NEEDS_REVIEW)
  revision           Int                 @default(1)
  approvedAt         DateTime?           @map("approved_at")
  outlookState          OutlookDraftState   @default(NOT_CREATED) @map("outlook_state")
  outlookMessageId      String?             @unique @map("outlook_message_id")
  outlookWebLink        String?             @map("outlook_web_link")
  outlookError          String?             @map("outlook_error")
  outlookDraftRevision  Int?                @map("outlook_draft_revision")
  outlookDraftCreatedAt DateTime?           @map("outlook_draft_created_at")
  replySourceMessageId  String?             @map("reply_source_message_id")
  sentConfirmedAt       DateTime?           @map("sent_confirmed_at")
  sentSubject           String?             @map("sent_subject")
  sentBody              String?             @map("sent_body")
  sentToAddress         String?             @map("sent_to_address")
  autoSendState         AutoSendState?      @map("auto_send_state")
  /// When the autopilot sends (SCHEDULED) or would have sent (SHADOW).
  autoSendAt            DateTime?           @map("auto_send_at")
  /// When Outlook accepted the autopilot's send; the rolling daily limit counts these.
  autoSentAt            DateTime?           @map("auto_sent_at")
  autoSendError         String?             @map("auto_send_error")
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  attachmentResume   Resume              @relation(fields: [attachmentResumeId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([outlookState])
  @@index([attachmentResumeId])
  @@index([autoSendState, autoSendAt])
  @@index([autoSentAt])
  @@map("outreach_drafts")
}

model OutlookConnection {
  id                  String   @id @default("primary")
  encryptedTokenCache String   @map("encrypted_token_cache")
  connectedAt         DateTime @default(now()) @map("connected_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("outlook_connections")
}

model FollowUpSuggestion {
  id                     String            @id @default(cuid())
  outlookMessageId       String            @unique @map("outlook_message_id")
  opportunityId          String?           @map("opportunity_id")
  status                 FollowUpStatus    @default(PENDING)
  fromAddress            String            @map("from_address")
  subject                String
  receivedAt             DateTime          @map("received_at")
  event                  FollowUpEvent?
  proposedActivity       ActivityType?     @map("proposed_activity")
  proposedStage          ApplicationStage? @map("proposed_stage")
  proposedWaitingOn      String?           @map("proposed_waiting_on")
  proposedNextAction     String?           @map("proposed_next_action")
  proposedNextFollowUpAt DateTime?         @map("proposed_next_follow_up_at")
  confidence             Float?
  evidence               Json?
  error                  String?
  retryCount             Int               @default(0) @map("retry_count")
  analyzedAt             DateTime?         @map("analyzed_at")
  /** When the scan applied the follow-up fields on its own; the Stage part still waits for the user. */
  followUpAppliedAt      DateTime?         @map("follow_up_applied_at")
  decidedAt              DateTime?         @map("decided_at")
  opportunity            Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  @@index([status, receivedAt])
  @@index([opportunityId])
  @@map("follow_up_suggestions")
}

model Task {
  id         String     @id @default(cuid())
  kind       TaskKind
  status     TaskStatus @default(RUNNING)
  label      String
  subjectId  String?    @map("subject_id")
  href       String?
  progress   String?
  error      String?
  startedAt  DateTime   @default(now()) @map("started_at")
  finishedAt DateTime?  @map("finished_at")

  @@index([status, startedAt])
  @@index([subjectId])
  @@map("tasks")
}

model MailScanState {
  id                  String    @id @default("primary")
  watermark           DateTime?
  lastRunAt           DateTime? @map("last_run_at")
  lastSuccessAt       DateTime? @map("last_success_at")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastError           String?   @map("last_error")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("mail_scan_state")
}

/// The kill switch for automatic sending, flipped from the dashboard without a restart.
model AutopilotControl {
  id              String    @id @default("primary")
  sendPaused      Boolean   @default(false) @map("send_paused")
  /// When the daily digest last went out (or was attempted); one per local date.
  lastDigestAt    DateTime? @map("last_digest_at")
  lastDigestError String?   @map("last_digest_error")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("autopilot_control")
}
