# Runtime connection. Use the Supabase pooler URL in hosted environments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require"

# Optional direct connection used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Single-user access gate. Use long, unique values and keep the real values only in .env/secret storage.
APP_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# IANA timezone used to decide which follow-up calendar date is due.
APP_TIME_ZONE="UTC"

# Phase 4 AI analyzer. Keep the real key only in private environment storage.
OPENAI_API_KEY="REPLACE_WITH_A_PRIVATE_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5.6-sol"

# Phase 6 private approved candidate profile and Recruiter Outreach Skill. Keep the real file outside this repository.
OUTREACH_CONTEXT_PATH="/absolute/private/path/outside-repository/outreach-context.txt"

# Phase 7 Microsoft delegated OAuth. Register this exact callback as a Web redirect URI.
MICROSOFT_CLIENT_ID="00000000-0000-4000-8000-000000000000"
MICROSOFT_CLIENT_SECRET="REPLACE_WITH_A_PRIVATE_MICROSOFT_CLIENT_SECRET"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/outlook/callback"
# Generate 32 random bytes and base64-encode them. Never commit the real key.
OUTLOOK_TOKEN_ENCRYPTION_KEY="REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY"
