# Runtime connection. Use the Supabase pooler URL in hosted environments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?sslmode=require"

# Optional direct connection used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Single-user access gate. Use long, unique values and keep the real values only in .env/secret storage.
APP_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# IANA timezone used for follow-up due dates and the scheduled mail scan window.
# Must be a real IANA name such as America/Los_Angeles; an unrecognised value falls back to UTC.
APP_TIME_ZONE="UTC"

# Scheduled Outlook scan. Days are 0=Sunday..6=Saturday; hours are local to APP_TIME_ZONE.
MAIL_SCAN_ENABLED="true"
MAIL_SCAN_DAYS="1,2,3,4,5"
MAIL_SCAN_START_HOUR="6"
MAIL_SCAN_END_HOUR="15"
MAIL_SCAN_INTERVAL_MINUTES="60"

# Turning inbox mail that matches no tracked job into a pending source for review.
# off (default) = never; dryrun = judge and record the decision without importing; on = import.
# Imports stay pending until you confirm them, and the mailbox itself is never modified.
MAIL_INTAKE_SCAN="off"

# Autopilot for every job: scanned from Outlook (needs MAIL_INTAKE_SCAN="on") or pasted.
# Set it with the switch on the dashboard (Off / Drafts only / Send). This value only decides until
# the switch is first used: off (default), draft or shadow (= Drafts only), send.
AUTOPILOT="off"

# Share of the JD's stated skills your approved context must cover before the autopilot writes.
# 0.5 or 50 both mean half (the default).
MATCH_THRESHOLD="0.5"

# Automatic sending (AUTOPILOT="send"): the window to cancel in, and sends allowed per rolling 24 hours.
# Over the limit the best matches go first; the rest stay in Outlook for you.
AUTO_SEND_DELAY_MINUTES="10"
AUTO_SEND_DAILY_LIMIT="35"

# Daily digest emailed to you: what was sent automatically, what was not and why, what needs you.
# on = once per scan day at DIGEST_HOUR (default: MAIL_SCAN_END_HOUR). Needs delegated Mail.Send and an
# Outlook reconnect after turning it on. DIGEST_TO defaults to the connected mailbox itself.
DAILY_DIGEST="off"
DIGEST_HOUR=""
DIGEST_TO=""
# Base address for the digest's links; defaults to the origin of MICROSOFT_REDIRECT_URI.
APP_URL=""

# Letting the scan maintain Waiting On, Next Action and Follow-up Date by itself (RESTRICTIONS 1.2).
# on = apply them when one opportunity matched and the reading was confident; anything else = off.
# Stage is never changed this way, and every automatic update writes an Activity.
FOLLOW_UP_AUTO="off"

# Employer copied on C2C outreach. Private contact detail: keep the real address only in .env.
# Leave unset to never copy anyone.
EMPLOYER_CC_ADDRESS=""

# Phase 4 AI analyzer. Keep the real key only in private environment storage.
OPENAI_API_KEY="REPLACE_WITH_A_PRIVATE_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5.6-sol"

# Phase 6 private approved candidate profile and Recruiter Outreach Skill. Keep the real file outside this repository.
OUTREACH_CONTEXT_PATH="/absolute/private/path/outside-repository/outreach-context.txt"
# Uploaded resumes are copied here; blank uses ~/.contractor-agent/resumes.
RESUME_STORAGE_PATH=""

# Phase 7 Microsoft delegated OAuth. Register this exact callback as a Web redirect URI.
MICROSOFT_CLIENT_ID="00000000-0000-4000-8000-000000000000"
MICROSOFT_CLIENT_SECRET="REPLACE_WITH_A_PRIVATE_MICROSOFT_CLIENT_SECRET"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/outlook/callback"
# Generate 32 random bytes and base64-encode them. Never commit the real key.
OUTLOOK_TOKEN_ENCRYPTION_KEY="REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY"

# Phase 9 Dice exposure channel (REQUIREMENTS FR-14, rules/exposure.md). Applies to Dice Easy Apply jobs unattended.
# off (default) = never; dryrun = fill every application but stop before Submit; on = submit.
# Using it accepts the risk that Dice restricts the account (RESTRICTIONS §3).
EXPOSURE_MODE="off"
# The dedicated Chrome the channel drives: its own data directory, outside this repository.
# Start it with `npm run exposure:chrome` (first time: `-- --copy-from "<absolute Chrome profile dir>"`).
DICE_CHROME_USER_DATA_DIR="/absolute/private/path/outside-repository/dice-chrome"
EXPOSURE_CDP_URL="http://127.0.0.1:9222"
# Everything below is only the first-time default: once saved on the /exposure page, the page's values win.
EXPOSURE_KEYWORDS="java"
# ONE = today, THREE = last 3 days, SEVEN = last 7 days
EXPOSURE_POSTED_DATE="ONE"
# Any of CONTRACTS, THIRD_PARTY, FULLTIME, PARTTIME
EXPOSURE_EMPLOYMENT_TYPES="CONTRACTS,THIRD_PARTY"
EXPOSURE_PAGE_RATIO="0.6667"
EXPOSURE_MAX_PAGES="7"
EXPOSURE_TITLE_BLACKLIST="QA,Test,SDET"
EXPOSURE_COMPANY_BLACKLIST=""
EXPOSURE_DAILY_LIMIT="150"
EXPOSURE_PER_RUN_LIMIT="30"
EXPOSURE_JOB_DELAY_SECONDS="30"
EXPOSURE_MAX_CONSECUTIVE_FAILURES="5"
EXPOSURE_MAX_STEPS_PER_JOB="15"
EXPOSURE_EXECUTOR_MODEL="gpt-5.6-luna"
EXPOSURE_SUPERVISOR_MODEL="gpt-5.6-luna"
# Run window: 0=Sunday..6=Saturday, hours local to APP_TIME_ZONE.
EXPOSURE_DAYS="1,2,3,4,5"
EXPOSURE_START_HOUR="6"
EXPOSURE_END_HOUR="15"
EXPOSURE_INTERVAL_MINUTES="60"
